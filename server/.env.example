NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# docker-compose.yml reads the POSTGRES_* values when it creates the container,
# and DATABASE_URL has to match them. They are only read on first start: after
# that, changing them means `docker compose down -v` to drop the volume.
POSTGRES_USER=clickrush
POSTGRES_PASSWORD=clickrush
POSTGRES_DB=clickrush
POSTGRES_PORT=5432
DATABASE_URL=postgres://clickrush:clickrush@localhost:5432/clickrush

# Generate with: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_TTL=1h
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
